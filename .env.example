# ==============================================================================
# DR. TOOBA IQBAL (MBBS, MCPS) — CLINIC WEBSITE ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` for local development.
# Never commit real credentials or `.env.local` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CONFIGURATION (Exposed to Browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Canonical site URL (no trailing slash). Used for SEO canonicals, JSON-LD,
# sitemap generation, and strict CSRF Origin verification on POST endpoints.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare Turnstile Site Key (Public).
# Below is Cloudflare's official "always passes" dummy site key for local dev/testing.
# Replace with production widget site key in production deployment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Primary WhatsApp clinic number in international digits (no '+' or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER="923101777649"

# ------------------------------------------------------------------------------
# 2. BOT PROTECTION (Server-Only)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile Secret Key verified against challenges.cloudflare.com.
# Below is Cloudflare's official "always passes" dummy secret key for local dev.
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ------------------------------------------------------------------------------
# 3. DUAL-MODE APPOINTMENT STORAGE & PII ENCRYPTION (Server-Only)
# ------------------------------------------------------------------------------
# By default ("false"), appointment requests operate in stateless privacy mode:
# validated bookings are sent directly via email notification and WhatsApp handoff
# without persisting patient PII in a database.
# Set to "true" ONLY if encrypted PostgreSQL persistence via Prisma is required.
ENABLE_DB_STORAGE="false"

# PostgreSQL connection string (Required when ENABLE_DB_STORAGE="true").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dr_tooba_clinic?schema=public"

# 32-byte (64 hex characters) AES-256-GCM key used to encrypt patient phone
# numbers prior to database storage. Generate with: `openssl rand -hex 32`
PII_ENCRYPTION_KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

# 32-byte (64 hex characters) HMAC-SHA256 key used to compute deterministic
# blind indexes on normalized E.164 phone numbers for deduplication without
# exposing plaintext numbers. Generate with: `openssl rand -hex 32`
PII_BLIND_INDEX_KEY="f1e1d1c1b1a191817161514131211101f0e0d0c0b0a090807060504030201000"

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED RATE LIMITING (Server-Only — Upstash Redis)
# ------------------------------------------------------------------------------
# Enforces max 5 booking attempts per 10 minutes per client IP.
# When left blank in local development, automatically falls back to an
# isolated in-memory sliding-window rate limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 5. CLINIC EMAIL NOTIFICATIONS (Server-Only — Resend or SMTP Fallback)
# ------------------------------------------------------------------------------
# Primary transactional email provider (https://resend.com)
RESEND_API_KEY=""

# Destination clinic email address that receives new appointment requests
NOTIFY_EMAIL_TO="clinic@drtoobaiqbal.com"

# Verified sender identity for outbound clinic notifications
NOTIFY_EMAIL_FROM="Dr. Tooba Iqbal Clinic <bookings@drtoobaiqbal.com>"

# Optional SMTP fallback if RESEND_API_KEY is not used
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ------------------------------------------------------------------------------
# 6. DATA RETENTION & AUTOMATED 90-DAY PII PURGE (Server-Only)
# ------------------------------------------------------------------------------
# High-entropy Bearer secret required to invoke `POST /api/cron/retention`
# from GitHub Actions (`cleanup-retention.yml`) or platform cron scheduler.
# Generate with: `openssl rand -hex 32`
CRON_SECRET="replace-with-minimum-32-character-random-cron-secret-token"
